rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Link US — security rules for the named Firestore database 'usa'.
//
// The organising principle here is the inverse of the Israeli ruleset. There, a
// student is deliberately global and a school is only a unit of work. Here the
// school is a closed world: every user carries a schoolId, and a document is
// readable only by members of the same school.
//
// The single load-bearing invariant is that schoolId is never written by a
// client. It is established once, server-side, by usRegisterWithSchoolCode
// after it has verified a school code, and changed only by usAdminMoveUserSchool.
// Every isolation guarantee below rests on that. If a client could write its own
// schoolId, all of this would be decorative.
//
// Consequence worth knowing before editing: in Firestore a query fails as a
// whole if a single document in its result would fail the read rule. Scoping
// reads by schoolId therefore breaks any client query that does not itself
// filter by schoolId. That is intended — it makes leaks fail loudly at
// development time rather than silently in production — but it means client and
// rules must be changed together.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Admin is a custom claim, set server-side only; a client cannot forge it.
    // Admin writes run through Cloud Functions with the Admin SDK and bypass
    // these rules entirely, so isAdmin() matters only for the panel's direct reads.
    function isAdmin() {
      return isAuth() && request.auth.token.get('admin', false) == true;
    }

    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // schoolId is mirrored into a custom claim for every role, so the common
    // path costs no document read. The fallback to the user document covers the
    // window after registration and before the client refreshes its ID token.
    function claimSchoolId() {
      return request.auth.token.get('schoolId', '');
    }

    function mySchoolId() {
      return claimSchoolId() != '' ? claimSchoolId() : myDoc().get('schoolId', '');
    }

    function myRole() {
      return request.auth.token.get('admin', false) == true
        ? 'admin'
        : myDoc().get('role', '');
    }

    // The isolation predicate. Note it is false when either side is empty, so a
    // user without a schoolId sees nothing rather than everything.
    function sameSchool(schoolId) {
      return isAuth() && schoolId != '' && mySchoolId() == schoolId;
    }

    function isStaffOf(schoolId) {
      return sameSchool(schoolId) && myRole() == 'staff';
    }

    function isMyOwnSchool() {
      return sameSchool(resource.data.get('schoolId', ''));
    }

    // ─── Schools ────────────────────────────────────────────────────────────
    // Unlike the Israeli ruleset, this is NOT publicly readable. There the
    // registration form had to list every school before the user authenticated.
    // Here registration is code-based, so no pre-auth listing is needed — which
    // closes school enumeration entirely.
    match /schools/{schoolId} {
      allow read: if isAdmin() || sameSchool(schoolId);
      allow create, update, delete: if false;

      // The join code, exposed to admins and to the school's own staff so a
      // principal can add teachers without going through a system admin.
      match /private/{docId} {
        allow read: if isAdmin() || isStaffOf(schoolId);
        allow write: if false;
      }
    }

    // Reverse map code -> schoolId. Never client-readable; if it were, codes
    // could be enumerated and the closed world would be open. Rules can still
    // get() it server-side.
    match /schoolCodes/{code} {
      allow read, write: if false;
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Yourself, an admin, or someone at your school. This is the rule that
      // makes the world closed, and the one that will break any unfiltered
      // users query left in the client.
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isMyOwnSchool()
      );

      // No client-side user creation for ANY role. In the Israeli ruleset a
      // client could create its own student or mentor document; here that would
      // let anyone assert membership in any school by typing a schoolId into
      // DevTools. All registration goes through usRegisterWithSchoolCode, which
      // verifies the code with the Admin SDK and writes the document itself.
      allow create: if false;

      allow update: if isAuth() && (
        // Admin: school, homeroom, group membership, mentor approval.
        // The key list is closed on purpose — changing role must stay exclusive
        // to usAdminSetUserRole, which keeps the custom claim in sync.
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['schoolId', 'schoolName', 'gradeLevel', 'homeroomId',
                    'homeroomName', 'joinedGroupIds', 'mentorStatus'])) ||

        // Self-update. schoolId, role and gradeLevel are immutable from the
        // client: school transfer is usAdminMoveUserSchool (which also updates
        // the claim), and grade level determines who may mentor whom.
        (request.auth.uid == userId &&
         request.resource.data.get('role', null) == resource.data.get('role', null) &&
         request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '') &&
         request.resource.data.get('gradeLevel', null) == resource.data.get('gradeLevel', null)) ||

        // Staff approve or reject peer mentors and assign homerooms — only for
        // their own school. Any student may apply to mentor, so this approval
        // step is the sole gate on who appears in the volunteer list.
        (request.auth.uid != userId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['mentorStatus', 'homeroomId', 'homeroomName']) &&
         resource.data.get('role', '') == 'mentor' &&
         isStaffOf(resource.data.get('schoolId', '')) &&
         // A homeroom from another school would corrupt that school's reports.
         (request.resource.data.get('homeroomId', null) == resource.data.get('homeroomId', null) ||
          request.resource.data.get('homeroomId', '') == '' ||
          (exists(/databases/$(database)/documents/classes/$(request.resource.data.homeroomId)) &&
           get(/databases/$(database)/documents/classes/$(request.resource.data.homeroomId))
             .data.get('schoolId', '') == mySchoolId()))) ||

        // Mutual friend removal — same school only.
        (request.auth.uid != userId &&
         isMyOwnSchool() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
         resource.data.get('friends', []).hasAny([request.auth.uid]) &&
         !request.resource.data.friends.hasAny([request.auth.uid])) ||

        // Friend addition — same school only. Without the sameSchool check a
        // cross-school friendship could be forged by writing directly to the
        // other user's document, bypassing the scoped search.
        (request.auth.uid != userId &&
         isMyOwnSchool() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
         !resource.data.get('friends', []).hasAny([request.auth.uid]) &&
         request.resource.data.friends.hasAny([request.auth.uid]))
      );

      // Deletion only via usAdminDeleteUser, which also removes the Auth
      // account and the orphaned references.
      allow delete: if false;
    }

    // ─── Homerooms (the 'classes' collection) ───────────────────────────────
    // Retained under the original collection name to avoid a rename migration,
    // but the meaning has changed: a document here is an OPTIONAL homeroom or
    // advisory section within one grade level, not a mandatory cohort. Grade
    // level itself is a static enum in src/config/market.js and needs no
    // collection, which is why this is no longer publicly readable.
    match /classes/{classId} {
      allow read: if isAdmin() || isMyOwnSchool();

      allow create: if isAdmin() ||
        (isStaffOf(request.resource.data.get('schoolId', '')) &&
         request.resource.data.get('schoolId', '') == mySchoolId());
      allow update: if isAdmin() || (
        isStaffOf(resource.data.get('schoolId', '')) &&
        request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '')
      );
      allow delete: if isAdmin() || isStaffOf(resource.data.get('schoolId', ''));
    }

    // ─── Groups ─────────────────────────────────────────────────────────────
    // Interest groups are global in the Israeli product. Here they are
    // school-scoped like everything else, so schoolId is mandatory on create
    // and must match the creator's own school.
    match /groups/{groupId} {
      allow read: if isAdmin() || isMyOwnSchool();

      allow create: if isAuth() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.get('schoolId', '') != '' &&
        request.resource.data.schoolId == mySchoolId();

      allow update: if isAuth() &&
        request.resource.data.get('schoolId', '') == resource.data.get('schoolId', '') && (
          isAdmin() ||
          (isMyOwnSchool() && resource.data.createdBy == request.auth.uid) ||
          (isMyOwnSchool() &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']))
        );

      allow delete: if isAuth() && (
        isAdmin() ||
        (isMyOwnSchool() && resource.data.createdBy == request.auth.uid)
      );

      match /members/{uid} {
        function groupSchoolId() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data.get('schoolId', '');
        }

        allow read: if isAdmin() || sameSchool(groupSchoolId());
        allow create: if isAuth() && (
          isAdmin() ||
          (request.auth.uid == uid && sameSchool(groupSchoolId()))
        );
        allow update: if isAdmin();
        allow delete: if isAuth() && (
          isAdmin() ||
          request.auth.uid == uid ||
          get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid
        );
      }
    }

    // ─── Chats ──────────────────────────────────────────────────────────────
    // Access stays participant-based. Cross-school chats cannot form because
    // user search and the volunteer list are both school-scoped, and friend
    // writes above are guarded — so there is no path to obtaining a UID from
    // another school in the first place.
    match /chats/{chatId} {
      allow read: if isAdmin() || (isAuth() &&
        request.auth.uid in resource.data.get('participants', []));

      allow create: if isAuth() && (isAdmin() ||
        request.auth.uid in request.resource.data.get('participants', []));

      allow update: if isAuth() && (
        isAdmin() ||
        request.auth.uid in resource.data.get('participants', []) ||
        (resource.data.get('type', '') == 'group' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
         request.resource.data.participants.hasAll(resource.data.get('participants', [])) &&
         request.resource.data.participants.hasAll([request.auth.uid])) ||
        (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['helpRequested', 'helpRequestedAt', 'helpRequestedBy']) &&
         request.resource.data.get('helpRequestedBy', '') == request.auth.uid)
      );

      match /messages/{messageId} {
        allow read: if isAdmin() || (isAuth() && (
          !exists(/databases/$(database)/documents/chats/$(chatId)) ||
          request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])));

        allow create: if isAuth() && (
          !exists(/databases/$(database)/documents/chats/$(chatId)) ||
          request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
        );

        allow update, delete: if isAuth() && (
          isAdmin() ||
          resource.data.senderId == request.auth.uid
        );
      }
    }

    // ─── Friend Requests ────────────────────────────────────────────────────
    match /friendRequests/{requestId} {
      allow read: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      // The sender must be at the recipient's school. This is the one place a
      // client names another user by UID without having discovered them through
      // a scoped query, so the check has to happen here rather than upstream.
      allow create: if isAuth() &&
        request.resource.data.fromUid == request.auth.uid &&
        sameSchool(
          get(/databases/$(database)/documents/users/$(request.resource.data.toUid))
            .data.get('schoolId', '')
        );
      allow update: if isAuth() && resource.data.toUid == request.auth.uid;
      allow delete: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ─── Distress Alerts ────────────────────────────────────────────────────
    // Far simpler than the Israeli version. There, a student had no school, so
    // a Cloud Function had to walk the student's mentoring chats, collect the
    // mentors' schools and write back notifySchoolIds before anyone could be
    // notified — and a student with no mentor yet produced an alert that
    // reached nobody. Here the student carries schoolId, so the alert is
    // addressed the moment it is written and cannot be unrouted.
    match /distressAlerts/{alertId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.get('uid', '') == request.auth.uid) ||
        isStaffOf(resource.data.get('schoolId', ''));

      allow create: if isAuth() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.get('schoolId', '') == mySchoolId() &&
        request.resource.data.schoolId != '';

      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'handled', 'handledBy', 'handledAt']) && (
        isAdmin() || isStaffOf(resource.data.get('schoolId', ''))
      );

      allow delete: if false;
    }

    // ─── Mentoring Hours ────────────────────────────────────────────────────
    // schoolId is denormalised onto the document because rules cannot join:
    // the staff query must be where('schoolId','==',…), so the field has to
    // live here.
    match /mentoringHours/{hoursId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.get('mentorUid', '') == request.auth.uid) ||
        isStaffOf(resource.data.get('schoolId', ''));

      allow create: if isAuth() &&
        request.resource.data.mentorUid == request.auth.uid &&
        request.resource.data.get('schoolId', '') != '' &&
        request.resource.data.schoolId == mySchoolId();

      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'approvedBy', 'approvedAt']) &&
        (isAdmin() || isStaffOf(resource.data.get('schoolId', '')));

      allow delete: if false;
    }

    // ─── Mentor Sessions (automatic time tracking) ──────────────────────────
    match /mentorSessions/{sessionId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.get('uid', '') == request.auth.uid) ||
        isStaffOf(resource.data.get('schoolId', ''));

      allow create: if isAuth() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.get('schoolId', '') == mySchoolId();

      allow update: if isAuth() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endAt', 'minutes']);

      allow delete: if false;
    }

    // ─── Reflections ────────────────────────────────────────────────────────
    // Private to the mentor who wrote them, and to admins.
    match /reflections/{reflectionId} {
      allow read: if isAdmin() ||
        (isAuth() && resource.data.get('mentorUid', '') == request.auth.uid);

      allow create: if isAuth() &&
        request.resource.data.mentorUid == request.auth.uid;

      allow update, delete: if isAuth() &&
        resource.data.get('mentorUid', '') == request.auth.uid;
    }

  }
}
